# Public frontend config
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only Neon Managed Better Auth settings. `neon deploy` supplies the
# base URL; generate the two application secrets independently and never
# prefix them with NEXT_PUBLIC_.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BRIDGE_SECRET=

# Cloudflare Turnstile site key. This testing key is safe for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
